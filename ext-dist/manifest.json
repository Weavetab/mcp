{
  "manifest_version": 3,
  "name": "Weavetab Agent",
  "version": "1.0.52212",
  "description": "Native browser agent for Weavetab MCP",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Weavetab Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "omnibox": {
    "keyword": "Weavetab"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "hud/index.html",
        "hud/hud.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-hud": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Toggle WeaveTab HUD"
    },
    "toggle-debug": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle WeaveTab Debug Menu"
    }
  }
}
